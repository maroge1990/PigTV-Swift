# Tools/testflight.sh reads these from the environment or ~/.pigtv-testflight.env on the Mac (chmod 600).
# Names only: real values never go in the repository.
PIGTV_TEAM_ID=          # the developer program team (10 characters)
PIGTV_ASC_KEY_ID=       # App Store Connect API key ID; the key must have the Admin role (cloud signing)
PIGTV_ASC_ISSUER_ID=    # the issuer ID shown above the keys (Users and Access → Integrations → App Store Connect API)
PIGTV_ASC_KEY_PATH=     # ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8 on the Mac (chmod 600)
